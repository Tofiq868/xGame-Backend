{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "App": {
    "PublicBaseUrl": "https://xgame-backend-production.up.railway.app",
    "FrontendBaseUrl": "https://game-zone-rose.vercel.app",
